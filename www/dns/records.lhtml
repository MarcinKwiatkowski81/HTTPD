<%
-- dns/records.lhtml — lista rekordów wybranej strefy (lub wszystkich)

local base = httpd.path():match("^(.*/)") or "/dns/"
local ok_lib, lib = pcall(dofile, "/home/mkwiatkowski/Website/HTTPD/www/dns/lib.lua")

local sid      = httpd.get_cookie("DNSSID")
local username = sid and httpd.session_get(sid) or nil
if not username then httpd.redirect("/dns/login.lua"); return end

local filter_zone = httpd.get_param("zone") or ""
local flash_ok    = httpd.get_param("ok")
local flash_err   = httpd.get_param("err")

local zones, err = lib.load_zones()
if err then flash_err = err end

-- Spłaszcz rekordy do jednej tabeli z polem zone_name
local rows = {}
for _, zone in ipairs(zones) do
    if filter_zone == "" or zone.name == filter_zone then
        for _, rec in ipairs(zone.records or {}) do
            if rec.deleted ~= "true" and rec.deleted ~= true then
                table.insert(rows, {
                    zone    = zone.name,
                    uid     = rec.uid   or "",
                    name    = rec.name  or "@",
                    rtype   = rec.rtype or "?",
                    ttl     = rec.ttl   or "300",
                    value   = lib.rdata_str(rec),
                    origin  = rec.origin or "",
                })
            end
        end
    end
end

-- Sortowanie: strefa → nazwa → typ
table.sort(rows, function(a,b)
    if a.zone ~= b.zone then return a.zone < b.zone end
    if a.name ~= b.name then return a.name < b.name end
    return a.rtype < b.rtype
end)

local title = filter_zone ~= "" and ("Rekordy: " .. filter_zone) or "Wszystkie rekordy"
%>
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> — Panel DNS</title>
  <style>
    :root { --bg:#0d1117; --surface:#161b22; --border:#30363d;
            --text:#c9d1d9; --muted:#8b949e; --accent:#388bfd;
            --green:#3fb950; --red:#f85149; --yellow:#d29922; }
    *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
    body { font:13px/1.6 'Segoe UI',system-ui,sans-serif;
           background:var(--bg); color:var(--text); min-height:100vh; }
    .layout { display:grid; grid-template-columns:220px 1fr; min-height:100vh; }
    .sidebar { background:var(--surface); border-right:1px solid var(--border);
               padding:1.5rem 0; display:flex; flex-direction:column; }
    .sidebar-brand { padding:0 1.25rem 1.5rem; font-size:1.1rem; font-weight:700;
                     color:var(--accent); border-bottom:1px solid var(--border);
                     margin-bottom:1rem; }
    .sidebar-brand span { font-size:.75rem; color:var(--muted);
                          display:block; font-weight:400; }
    .nav-item { display:block; padding:.55rem 1.25rem; color:var(--muted);
                text-decoration:none; font-size:.875rem;
                border-left:3px solid transparent;
                transition:color .15s, border-color .15s, background .15s; }
    .nav-item:hover  { color:var(--text); background:rgba(255,255,255,.04); }
    .nav-item.active { color:var(--accent); border-left-color:var(--accent);
                       background:rgba(56,139,253,.08); }
    .nav-sep { border:none; border-top:1px solid var(--border); margin:.75rem 0; }
    .nav-user { margin-top:auto; padding:1rem 1.25rem;
                border-top:1px solid var(--border); font-size:.8rem; color:var(--muted); }
    .nav-user strong { color:var(--text); display:block; }

    .main { padding:2rem; overflow:auto; }
    .page-header { display:flex; align-items:center;
                   justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem; }
    .page-title { font-size:1.3rem; font-weight:600; }
    .page-sub   { font-size:.8rem; color:var(--muted); margin-top:.1rem; }

    .alert { padding:.65rem 1rem; border-radius:6px; margin-bottom:1rem;
             font-size:.85rem; display:flex; align-items:center; gap:.5rem; }
    .alert-ok  { background:rgba(63,185,80,.1); border:1px solid rgba(63,185,80,.3); color:var(--green); }
    .alert-err { background:rgba(248,81,73,.1); border:1px solid rgba(248,81,73,.3); color:var(--red); }

    /* Toolbar */
    .toolbar { display:flex; gap:.6rem; align-items:center;
               flex-wrap:wrap; margin-bottom:1.25rem; }
    .filter-select { background:var(--surface); border:1px solid var(--border);
                     color:var(--text); border-radius:6px; padding:.45rem .7rem;
                     font-size:.85rem; cursor:pointer; }
    .search-input  { background:var(--surface); border:1px solid var(--border);
                     color:var(--text); border-radius:6px; padding:.45rem .7rem;
                     font-size:.85rem; outline:none; width:200px;
                     transition:border-color .15s; }
    .search-input:focus { border-color:var(--accent); }

    /* Tabela */
    .tbl-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; font-size:.82rem; }
    thead th { background:var(--surface); padding:.6rem .75rem; text-align:left;
               color:var(--muted); font-weight:600; border-bottom:1px solid var(--border);
               white-space:nowrap; position:sticky; top:0; z-index:1; }
    tbody tr { border-bottom:1px solid rgba(48,54,61,.6);
               transition:background .1s; }
    tbody tr:hover { background:rgba(255,255,255,.025); }
    td { padding:.55rem .75rem; vertical-align:top; }
    .td-mono { font-family:monospace; font-size:.8rem; }

    .badge-type { display:inline-block; padding:.1rem .45rem; border-radius:4px;
                  font-size:.7rem; font-weight:700; font-family:monospace; }
    .type-A     { background:rgba(56,139,253,.15); color:#388bfd; }
    .type-AAAA  { background:rgba(137,80,249,.15); color:#8957e5; }
    .type-CNAME { background:rgba(63,185,80,.15);  color:#3fb950; }
    .type-MX    { background:rgba(210,153,34,.15); color:#d29922; }
    .type-NS    { background:rgba(248,81,73,.15);  color:#f85149; }
    .type-TXT   { background:rgba(201,209,217,.1); color:#c9d1d9; }
    .type-SOA   { background:rgba(188,140,255,.15);color:#bc8cff; }
    .type-PTR   { background:rgba(63,185,80,.1);   color:#3fb950; }
    .type-SRV   { background:rgba(56,139,253,.1);  color:#388bfd; }
    .type-CAA   { background:rgba(210,153,34,.1);  color:#d29922; }

    .btn { display:inline-flex; align-items:center; gap:.35rem; padding:.4rem .8rem;
           border-radius:6px; font-size:.8rem; font-weight:600; cursor:pointer;
           text-decoration:none; border:1px solid var(--border);
           transition:background .15s; }
    .btn-primary { background:var(--accent); color:#fff; border-color:var(--accent); }
    .btn-primary:hover { background:#1f6feb; }
    .btn-ghost { background:transparent; color:var(--text); }
    .btn-ghost:hover { background:rgba(255,255,255,.06); }
    .btn-danger { background:transparent; color:var(--red); border-color:rgba(248,81,73,.3); }
    .btn-danger:hover { background:rgba(248,81,73,.1); }

    .row-count { font-size:.78rem; color:var(--muted); }
  </style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand">⬡ Panel DNS<span>SoftStudio</span></div>
    <a class="nav-item" href="/dns/">Przegląd stref</a>
    <a class="nav-item active" href="/dns/records.lhtml">Wszystkie rekordy</a>
    <hr class="nav-sep">
    <a class="nav-item" href="/dns/add_zone.lhtml">+ Nowa strefa</a>
    <a class="nav-item" href="/dns/add_record.lhtml">+ Nowy rekord</a>
    <hr class="nav-sep">
    <a class="nav-item" href="/dns/peers.lhtml">Węzły P2P</a>
    <a class="nav-item" href="/dns/log.lhtml">Dziennik</a>
    <div class="nav-user">
      <strong><%= username %></strong>
      <a href="/dns/logout.lua" style="color:var(--red);text-decoration:none">Wyloguj</a>
    </div>
  </aside>

  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-title"><%= lib.h(title) %></div>
        <div class="page-sub"><%= #rows %> aktywnych rekordów</div>
      </div>
      <a class="btn btn-primary" href="/dns/add_record.lhtml<%= filter_zone ~= '' and ('?zone='..httpd.urlencode(filter_zone)) or '' %>">+ Nowy rekord</a>
    </div>

<%  if flash_ok then %><div class="alert alert-ok">✓ <%= flash_ok %></div><% end %>
<%  if flash_err then %><div class="alert alert-err">✗ <%= flash_err %></div><% end %>

    <div class="toolbar">
      <form method="GET" style="display:contents">
        <select class="filter-select" name="zone" onchange="this.form.submit()">
          <option value="">Wszystkie strefy</option>
<%        for _, z in ipairs(zones) do %>
          <option value="<%= lib.h(z.name) %>"<%= z.name == filter_zone and " selected" or "" %>><%= lib.h(z.name) %></option>
<%        end %>
        </select>
        <input class="search-input" type="search" id="q" placeholder="Szukaj…" oninput="filterRows(this.value)">
      </form>
    </div>

    <div class="tbl-wrap">
      <table id="rtable">
        <thead>
          <tr>
            <th>Strefa</th>
            <th>Nazwa</th>
            <th>Typ</th>
            <th>TTL</th>
            <th>Wartość</th>
            <th>Węzeł</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
<%  if #rows == 0 then %>
          <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--muted)">
            Brak rekordów.
            <a href="/dns/add_record.lhtml" style="color:var(--accent)">Dodaj pierwszy</a>
          </td></tr>
<%  end %>
<%  for _, r in ipairs(rows) do %>
          <tr data-search="<%= lib.h((r.zone.." "..r.name.." "..r.rtype.." "..r.value):lower()) %>">
            <td class="td-mono" style="color:var(--muted);font-size:.75rem"><%= lib.h(r.zone) %></td>
            <td class="td-mono"><%= r.name == "" and "<em style='color:var(--muted)'>@</em>" or lib.h(r.name) %></td>
            <td><span class="badge-type type-<%= r.rtype %>"><%= lib.h(r.rtype) %></span></td>
            <td style="color:var(--muted)"><%= lib.h(r.ttl) %></td>
            <td class="td-mono" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= lib.h(r.value) %>"><%= lib.h(r.value) %></td>
            <td style="color:var(--muted);font-size:.72rem"><%= lib.h(r.origin) %></td>
            <td style="white-space:nowrap">
              <a class="btn btn-ghost" href="/dns/edit_record.lhtml?uid=<%= httpd.urlencode(r.uid) %>&zone=<%= httpd.urlencode(r.zone) %>" style="font-size:.75rem">✎</a>
              <a class="btn btn-danger" href="/dns/delete_record.lua?uid=<%= httpd.urlencode(r.uid) %>&zone=<%= httpd.urlencode(r.zone) %>"
                 onclick="return confirm('Usunąć rekord <%= lib.h(r.name) %> <%= lib.h(r.rtype) %>?')"
                 style="font-size:.75rem">✕</a>
            </td>
          </tr>
<%  end %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<script>
function filterRows(q) {
    q = q.toLowerCase();
    document.querySelectorAll('#rtable tbody tr[data-search]').forEach(function(tr) {
        tr.style.display = tr.dataset.search.includes(q) ? '' : 'none';
    });
}
</script>
</body>
</html>
